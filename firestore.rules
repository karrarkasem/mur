rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && role() == "admin";
    }

    function isManager() {
      return signedIn() && (role() == "admin" || role() == "manager");
    }

    function isAssignedTo(taskData) {
      return signedIn() && taskData.assignedToUid == request.auth.uid;
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read: if signedIn();
      // Any signed-in team member can log a follow-up / activity note or
      // set the next follow-up date on a lead - not manager-only, since
      // following up with leads is normal day-to-day sales work. Anything
      // beyond those two fields (status, contact info, etc.) stays
      // manager-only so a viewer/sales account can't rewrite a lead.
      allow update: if isManager() ||
        (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nextFollowUp", "activityLog"]));
      allow delete: if isManager();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create, update, delete: if isManager();
    }

    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create, delete: if isManager();
      // Managers can edit everything; the assigned person can update their
      // own task (e.g. mark done, add a blocker note) without being a
      // manager - but only those two fields, not title/priority/assignee.
      allow update: if isManager() ||
        (isAssignedTo(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "blockerNotes"]));
    }

    match /quotes/{quoteId} {
      allow read: if signedIn();
      allow create, update, delete: if isManager();
    }

    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow create, update, delete: if isManager();
    }

    match /contentPosts/{postId} {
      allow read: if signedIn();
      allow create, update, delete: if isManager();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // EV Charging Management. Built incrementally by phase - tariffs and
    // the wallet ledger get their own rules once those phases are built,
    // since the wallet write pattern needs to be exact.
    //
    // Station name/location/status is meant to be visible at the point of
    // use (a customer scanning the QR code on the physical unit isn't
    // signed in), so it's public read - nothing sensitive lives here.
    match /evChargers/{chargerId} {
      allow read: if true;
      allow create, update, delete: if isManager();
    }

    // Wildcard path (not nested under evChargers/{chargerId}) so this also
    // covers the dashboard's collectionGroup("connectors") query, which a
    // nested match rule would not authorize.
    match /{path=**}/connectors/{connectorId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /evChargingSessions/{sessionId} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    // "get" (read one doc by an ID you already know) is public so the QR
    // page can show a customer's own name/balance after their RFID tag
    // resolves to a customerId; "list" (browse/query the whole collection)
    // stays signed-in only, so an anonymous visitor can never enumerate or
    // search other customers - only look up the exact one they already
    // have the ID for.
    match /evCustomers/{customerId} {
      allow get: if true;
      allow list: if signedIn();
      allow create, update, delete: if isManager();
    }

    // Doc ID is the RFID tag code itself. "get" is public so the QR page
    // can resolve a scanned/typed tag to its owner in one direct read -
    // physically holding the card is the credential, same as tapping it on
    // a real reader. "list" (browsing all tags) stays manager-only.
    match /evRfidTokens/{tagId} {
      allow get: if true;
      allow list: if isManager();
      allow create, update, delete: if isManager();
    }

    // Alternate identification for residents without an RFID card yet:
    // doc ID is a staff-assigned resident code, containing a PIN field.
    // Same "get by known ID, no list" pattern as RFID - you can only look
    // up an account if you already know its code, and the PIN is checked
    // client-side after that single read (there's no way to browse or
    // guess-search codes since list() stays manager-only).
    match /evLoginCodes/{code} {
      allow get: if true;
      allow list: if isManager();
      allow create, update, delete: if isManager();
    }

    // Public customer requests (wallet top-up, RFID card, start-charging) -
    // same pattern as /leads: anyone can create one, only staff can read/
    // act on them, since there's no customer-auth system yet.
    match /evTopupRequests/{id} {
      allow create: if true;
      allow read, update: if isManager();
    }

    match /evRfidRequests/{id} {
      allow create: if true;
      allow read, update: if isManager();
    }

    match /evChargeRequests/{id} {
      allow create: if true;
      allow read, update: if isManager();
    }

    // Single default price - public read so the QR page can show it before
    // the customer identifies themselves.
    match /evTariffs/{tariffId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Wallet ledger: only written by staff confirming a top-up (via a
    // transaction that also updates the customer's balance), never
    // directly from the public request form.
    match /evWalletTransactions/{id} {
      allow read, create: if isManager();
    }

    // Recycle bin: every delete across the app writes a record here first
    // (audit trail: who deleted what, when) instead of being destroyed
    // outright. Only managers/admins - the same people who can delete in
    // the first place - can see or restore from it; permanently purging
    // an entry is admin-only.
    match /deletedItems/{itemId} {
      allow read, create, update: if isManager();
      allow delete: if isAdmin();
    }

    // Deny anything not explicitly listed above (default-safe instead of
    // the previous open "allow read, write: if signedIn()" catch-all).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
